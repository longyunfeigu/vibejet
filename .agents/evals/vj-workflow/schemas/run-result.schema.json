{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "case_revision",
    "workflow_fingerprint",
    "variant",
    "trial",
    "runner",
    "passed",
    "valid_trial",
    "max_budget_usd",
    "timeout_sec",
    "duration_ms",
    "assertions"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "case_revision": {"type": "integer", "minimum": 1},
    "workflow_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "variant": {"type": "string"},
    "trial": {"type": "integer", "minimum": 1},
    "runner": {"enum": ["claude", "codex"]},
    "model": {"type": ["string", "null"]},
    "passed": {"type": "boolean"},
    "valid_trial": {"type": "boolean"},
    "max_budget_usd": {"type": "number", "exclusiveMinimum": 0},
    "timeout_sec": {"type": "integer", "minimum": 1},
    "runner_error": {"type": ["string", "null"]},
    "exit_code": {"type": "integer"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "tokens": {"type": ["integer", "null"], "minimum": 0},
    "human_interventions": {"type": ["integer", "null"], "minimum": 0},
    "rework_rounds": {"type": ["integer", "null"], "minimum": 0},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "passed", "evidence"],
        "properties": {
          "type": {"type": "string"},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
