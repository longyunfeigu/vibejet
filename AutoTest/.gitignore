# Test reports / run artifacts (generated) — do not commit
report/

# playwright-bdd generated test files
core/.gen-bdd/

# Node modules
node_modules/
**/node_modules/

# Playwright
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# Screenshots (keep only in reports)
*.png

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Auth state files (contain session tokens, never commit)
**/auth-state.json
**/auth-state-*.json

# Environment configs (contain credentials, never commit)
**/environments.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Optional: Keep test-cases directory if you want to version control generated tests
# test-cases/
__pycache__/

# vibejet: the root .gitignore ignores lib/ (Python default); AutoTest commits its runner libraries
!core/runner/lib/
