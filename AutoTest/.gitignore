# Test reports / run artifacts (generated) — do not commit
report/
!llm-bench/report/
!llm-bench/report/*.py
test-reports/
test-reports-*/

# playwright-bdd generated test files
core/.gen-bdd/

# Node modules
node_modules/
**/node_modules/

# Playwright
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# Screenshots (keep only in reports)
*.png
!test-reports/**/*.png

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Auth state files (contain session tokens, never commit)
**/auth-state.json
**/auth-state-*.json

# Environment configs (contain credentials, never commit)
**/environments.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Optional: Keep test-cases directory if you want to version control generated tests
# test-cases/
package-lock.json
__pycache__/

# Scenario-import test fixtures, regenerated at runtime by build-scenario-workbook.ts
modules/ai-simulation/scenario-file-import/cases/test-data/*.xlsx

# vibejet: the root .gitignore ignores lib/ and package-lock.json (Python and pnpm defaults);
# AutoTest needs both committed: runner libraries, and the lockfile for npm ci
!core/runner/lib/
!package-lock.json
