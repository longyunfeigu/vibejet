{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "../modules/**/steps/**/*.ts",
    "../modules/**/pages/**/*.ts",
    "../modules/**/legacy-specs/**/*.ts",
    "../modules/voice-agent/lang_detect/**/*.ts",
    "../core/runner/**/*.ts",
    "../core/release-check/**/*.ts",
    "../core/helpers/**/*.ts",
    "../core/api/**/*.ts",
    "./playwright.config.ts",
    "./env-config.ts",
    "./global-setup.ts"
  ],
  "exclude": [
    ".claude/**",
    "../core/.gen-bdd/**"
  ]
}
